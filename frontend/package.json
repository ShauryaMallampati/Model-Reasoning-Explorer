{
  "name": "mre-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {"node": "^22.13.0 || ^24.0.0 || >=26.0.0"},
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
